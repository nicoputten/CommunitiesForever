{
 "about": "Progress cases of the quests missions (CF-71), addon only: the site never computes progress. Never edit a case to make code pass. Each case adds its observations to new facts (Goals.observe) and expects Doomsday.progress of goal on them.",
 "cases": [
  { "name": "a quest above the character's level", "goal": "d.questUp", "value": 1, "target": 1, "done": true,
    "observations": [ { "kind": "questDone", "level": 12, "charLevel": 10 } ] },
  { "name": "a quest at the character's level is not above it", "goal": "d.questUp", "value": 0, "target": 1, "done": false,
    "observations": [ { "kind": "questDone", "level": 10, "charLevel": 10 } ] },
  { "name": "a quest without a level (stored by an older version) never counts as above", "goal": "d.questUp", "value": 0, "target": 1, "done": false,
    "observations": [ { "kind": "questDone", "charLevel": 10 } ] },
  { "name": "a group quest", "goal": "d.groupQuest", "value": 1, "target": 1, "done": true,
    "observations": [ { "kind": "questDone", "group": 3 } ] },
  { "name": "a normal quest is no group quest", "goal": "d.groupQuest", "value": 0, "target": 1, "done": false,
    "observations": [ { "kind": "questDone" } ] },
  { "name": "a class quest: the header is the character's class", "goal": "d.classQuest", "value": 1, "target": 1, "done": true,
    "observations": [ { "kind": "questDone", "classFile": "WARRIOR", "area": "Warrior" } ] },
  { "name": "another class's header or a zone is no class quest", "goal": "d.classQuest", "value": 0, "target": 1, "done": false,
    "observations": [ { "kind": "questDone", "classFile": "WARRIOR", "area": "Mage" },
                      { "kind": "questDone", "classFile": "WARRIOR", "area": "Durotar" } ] },
  { "name": "a dungeon quest", "goal": "d.dungeonQuest", "value": 1, "target": 1, "done": true,
    "observations": [ { "kind": "questDone", "dungeon": true, "area": "Wailing Caverns" } ] },
  { "name": "3 quests within 10 minutes on one character", "goal": "d.questBurst", "value": 3, "target": 3, "done": true,
    "observations": [ { "kind": "questDone", "guid": "Player-1-A", "t": 1000 },
                      { "kind": "questDone", "guid": "Player-1-A", "t": 1300 },
                      { "kind": "questDone", "guid": "Player-1-A", "t": 1600 } ] },
  { "name": "the third a second too late", "goal": "d.questBurst", "value": 2, "target": 3, "done": false,
    "observations": [ { "kind": "questDone", "guid": "Player-1-A", "t": 1000 },
                      { "kind": "questDone", "guid": "Player-1-A", "t": 1300 },
                      { "kind": "questDone", "guid": "Player-1-A", "t": 1601 } ] },
  { "name": "quick hand-ins on two characters don't add up", "goal": "d.questBurst", "value": 2, "target": 3, "done": false,
    "observations": [ { "kind": "questDone", "guid": "Player-1-A", "t": 1000 },
                      { "kind": "questDone", "guid": "Player-1-B", "t": 1100 },
                      { "kind": "questDone", "guid": "Player-1-A", "t": 1200 } ] },
  { "name": "5 different quests accepted; one taken twice counts once", "goal": "d.accept5", "value": 5, "target": 5, "done": true,
    "observations": [ { "kind": "questAccepted", "questID": 101 }, { "kind": "questAccepted", "questID": 102 },
                      { "kind": "questAccepted", "questID": 103 }, { "kind": "questAccepted", "questID": 103 },
                      { "kind": "questAccepted", "questID": 104 }, { "kind": "questAccepted", "questID": 105 } ] },
  { "name": "the same quest accepted again is no new quest", "goal": "d.accept5", "value": 2, "target": 5, "done": false,
    "observations": [ { "kind": "questAccepted", "questID": 101 }, { "kind": "questAccepted", "questID": 101 },
                      { "kind": "questAccepted", "questID": 102 }, { "kind": "questAccepted" } ] },
  { "name": "a quest handed in with a friend in the group", "goal": "d.questTogether", "value": 1, "target": 1, "done": true,
    "observations": [ { "kind": "questDone", "grouped": true } ] },
  { "name": "a quest handed in without a friend", "goal": "d.questTogether", "value": 0, "target": 1, "done": false,
    "observations": [ { "kind": "questDone", "grouped": false } ] },
  { "name": "weekly: 3 group quests", "goal": "w.groupQuests3", "value": 3, "target": 3, "done": true,
    "observations": [ { "kind": "questDone", "group": 5 }, { "kind": "questDone", "group": 2 },
                      { "kind": "questDone" }, { "kind": "questDone", "group": 3 } ] },
  { "name": "weekly: 4 of 5 quests above the level", "goal": "w.questUp5", "value": 4, "target": 5, "done": false,
    "observations": [ { "kind": "questDone", "level": 11, "charLevel": 10 }, { "kind": "questDone", "level": 12, "charLevel": 10 },
                      { "kind": "questDone", "level": 13, "charLevel": 12 }, { "kind": "questDone", "level": 20, "charLevel": 19 },
                      { "kind": "questDone", "level": 9, "charLevel": 10 } ] },
  { "name": "weekly: 5 quests with a friend", "goal": "w.duoQuests5", "value": 5, "target": 5, "done": true,
    "observations": [ { "kind": "questDone", "grouped": true }, { "kind": "questDone", "grouped": true },
                      { "kind": "questDone", "grouped": true }, { "kind": "questDone", "grouped": true },
                      { "kind": "questDone", "grouped": true }, { "kind": "questDone", "grouped": true } ] }
 ]
}
