  {
   "name": "fish over two zones, one at night and one with a friend",
   "observations": [
    { "kind": "fish", "count": 30 },
    { "kind": "extFish", "zone": "Elwynn Forest", "friend": false, "hour": 20 },
    { "kind": "fish", "count": 25 },
    { "kind": "extFish", "zone": "Westfall", "friend": true, "hour": 21 },
    { "kind": "extFish", "zone": "Westfall", "friend": false, "hour": 4 }
   ],
   "progress": { "d.fish20": [55, 20, true], "d.fish50": [55, 50, true], "w.fish100": [55, 100, false],
                 "d.fishZones": [2, 2, true], "w.fishZones4": [2, 4, false], "d.fishFriend": [1, 1, true],
                 "d.fishNight": [2, 1, true] }
  },
  {
   "name": "fishing in the evening and the morning is not the night, a zone without a name counts nothing",
